        const API_BASE = "http://localhost:3000/api";
const HOTEL_ID = 1; // Fixed Hotel ID as requested
let selectedType = null;

/**
 * 1. DATE LOGIC
 * Sets check-in to today and check-out to tomorrow by default.
 * Constraints ensure check-out is always after check-in.
 */
function initDates() {
    const checkin = document.getElementById('checkin');
    const checkout = document.getElementById('checkout');
    
    const today = new Date().toISOString().split('T')[0];
    checkin.min = today;
    checkin.value = today;

    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowStr = tomorrow.toISOString().split('T')[0];
    
    checkout.min = tomorrowStr;
    checkout.value = tomorrowStr;

    // Update checkout constraints when check-in changes
    checkin.addEventListener('change', (e) => {
        const nextDay = new Date(e.target.value);
        nextDay.setDate(nextDay.getDate() + 1);
        const nextDayStr = nextDay.toISOString().split('T')[0];
        
        checkout.min = nextDayStr;
        
        // If current checkout is now invalid, reset it to the new minimum
        if (checkout.value <= e.target.value) {
            checkout.value = nextDayStr;
        }
        updatePriceBreakdown();
    });

    checkout.addEventListener('change', updatePriceBreakdown);
}

/**
 * 2. DATA FETCHING (GET Method)
 * Retrieves the RoomTypeID from the URL parameters and fetches details.
 */
async function loadRoomDetails() {
    // 1. Grab the ID from the address bar (?id=X)
    const urlParams = new URLSearchParams(window.location.search);
    const roomTypeId = urlParams.get('id');

    // 2. Error Check
    if (!roomTypeId) {
        alert("Selection missing. Returning to rooms.");
        window.location.href = 'rooms.html';
        return;
    }

    try {
        // 3. Fetch specific room type details
        const response = await fetch(`http://localhost:3000/api/roomtypes/${roomTypeId}`);
        const response2 = await fetch(`http://localhost:3000/api/rooms/${HOTEL_ID,roomTypeId}`);
        selectedType = await response.json();
        room = await response2.json();

        // 4. Update the page
        document.getElementById('room-name').innerText = selectedType.capacity;
        document.getElementById('room-location').innerText = room.roomnumber;
        document.getElementById('room-price').innerText = `$${selectedType.pricepernight}`;
        document.getElementById('room-description').innerText = selectedType.description;
        updatePriceBreakdown(); // Call your pricing function
    } catch (err) {
        console.error("Error loading details:", err);
    }
}

/**
 * 3. PRICE CALCULATION
 * Calculates total stay cost based on selected dates.
 */
function updatePriceBreakdown() {
    if (!selectedType) return;

    const start = new Date(document.getElementById('checkin').value);
    const end = new Date(document.getElementById('checkout').value);
    
    // Calculate difference in days
    const diffTime = Math.abs(end - start);
    const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) || 1;
    
    const price = selectedType.pricepernight;
    const subtotal = price * nights;
    const discount = subtotal * 0.10; // 10% Member discount
    const serviceFee = 120;
    const grandTotal = (subtotal - discount) + serviceFee;

    // Update the price card UI
    document.getElementById('price-card').innerHTML = `
        <div class="flex justify-between mb-2">
            <span class="text-sm">${nights} Night(s) Stay ($${price} x ${nights})</span>
            <span class="text-sm font-semibold">$${subtotal}</span>
        </div>
        <div class="flex justify-between mb-2 text-green-600">
            <span class="text-sm">Member Privileges (10% Off)</span>
            <span class="text-sm font-semibold">-$${discount.toFixed(0)}</span>
        </div>
        <div class="flex justify-between mb-4">
            <span class="text-sm">Property Service Fee</span>
            <span class="text-sm font-semibold">$${serviceFee}</span>
        </div>
        <hr class="border-slate-200 mb-4"/>
        <div class="flex justify-between items-center">
            <span class="text-xl font-bold">Total</span>
            <span id="grand-total" class="text-2xl font-bold text-black">$${grandTotal.toFixed(0)}</span>
        </div>
    `;
}

/**
 * 4. SUBMIT BOOKING
 * Sends a POST request to create the booking.
 */
document.getElementById('confirmBookingBtn').addEventListener('click', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const roomTypeId = urlParams.get('id');
    const guestId = document.getElementById('guestid').value;
    const checkinDate = document.getElementById('checkin').value;
    const numGuest = document.getElementById('room-name').value;

    if (!guestId) {
        alert("Please enter a valid Guest ID.");
        return;
    }

    const bookingData = {
        GuestID: parseInt(guestId),
        RoomID: parseInt(roomTypeId), // Mapping RoomTypeID to RoomID as discussed
        BookingDate: new Date().toISOString().split('T')[0], // Today's date
        CheckInDate: checkinDate,
        CheckOutDate: checkoutDate,
        BookingStatus: 'Confirmed',
        NumberOfGuests: numGuest, // You can add an input for this if needed
        TotalAmount: updateCalculations()
    };

    try {
        const response = await fetch(`${API_BASE}/bookings`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(bookingData)
        });

        if (response.ok) {
